{
  "manifest_version": 2,
  "name": "Screen Capture and Record",
  "version": "2.0.0",
  "description": "Record your screen with your webcam and microphone, and save small videos that are easy to share. Everything stays on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Open the screen recorder"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the screen recorder"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "screen-capture-and-record@penguin-pants",
      "strict_min_version": "130.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
