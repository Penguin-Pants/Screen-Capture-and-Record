{
  "manifest_version": 2,
  "name": "Screen Capture and Record",
  "version": "2.0.0",
  "description": "Capture the visible area, a selected area or the full page, annotate the image and record your screen. All processing stays on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "downloads",
    "storage",
    "notifications",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "common.js",
      "capture.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Screen Capture and Record"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Capture a selected area"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the visible area"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture the full page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "screen-capture-and-record@penguin-pants",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
