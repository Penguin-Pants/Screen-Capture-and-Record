{
  "name": "screen-recorder",
  "version": "2.1.0",
  "private": true,
  "description": "Firefox extension that records the screen with webcam and microphone and saves small, shareable videos.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "web-ext lint --source-dir src",
    "start": "web-ext run --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "vendor": "node scripts/vendor.js"
  },
  "devDependencies": {
    "mediabunny": "1.61.0",
    "playwright-core": "1.56",
    "web-ext": "^8.10.0"
  }
}
